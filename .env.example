#=====================================================================#
#                         AIsafe - Frontend Config                    #
#=====================================================================#

# ai-safe backend URL (default: http://localhost:4000)
VITE_MDP_API_URL=http://localhost:4000

# JWT token for development (get from your auth provider / Keycloak)
# VITE_MDP_JWT_TOKEN=your-jwt-token-here

# App title override
VITE_APP_TITLE=AIsafe

# Base path for subdirectory hosting (e.g. /librechat/)
# Set this to /librechat/ when serving LibreChat under /librechat.
VITE_BASE_HREF=/librechat/

# Frontend dev server port (default: 3090)
# PORT=3090
